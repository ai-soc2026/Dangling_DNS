# Leave DATABASE_URL unset to use the local danglescan.db SQLite file.
# For PostgreSQL, copy this file to .env, replace the placeholders, and start
# Uvicorn with: uvicorn main:app --env-file .env --host 127.0.0.1 --port 8000
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/danglescan

# Used only by the one-time SQLite-to-PostgreSQL copy command.
POSTGRES_DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/danglescan
